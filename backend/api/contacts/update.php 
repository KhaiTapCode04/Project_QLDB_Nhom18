<?php
// backend/api/contacts/update.php - Update existing contact

// Set headers for CORS
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/json; charset=UTF-8");
header("Access-Control-Allow-Methods: PUT");
header("Access-Control-Max-Age: 3600");
header("Access-Control-Allow-Headers: Content-Type, Access-Control-Allow-Headers, Authorization, X-Requested-With");

// Include required files
include_once '../config/database.php';
include_once '../classes/Contact.php';
include_once '../classes/Auth.php';
include_once '../classes/Response.php';

// Handle preflight OPTIONS request
if($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit;
}

// Check if it's a PUT request
if($_SERVER['REQUEST_METHOD'] !== 'PUT') {
    Response::error("Only PUT method is allowed", 405);
}

// Get database connection
$database = new Database();
$db = $database->getConnection();

// Initialize auth and contact objects
$auth = new Auth();
$contact = new Contact($db);

// Get token from headers
$token = $auth->getBearerToken();

// Validate token
if(!$token || !($user_data = $auth->validateToken($token))) {
    Response::unauthorized("Invalid or missing token");
}

// Get user ID from token
$user_id = $user_data->user_id;

// Get posted data
$data = json_decode(file_get_contents("php://input"));

// Check if contact_id is provided
if(!property_exists($data, 'contact_id') || empty($data->contact_id)) {
    Response::error("Contact ID is required");
}

// Check if contact exists and belongs to user
if(!$contact->readOne($data->contact_id, $user_id)) {
    Response::notFound("Contact not found");
}

// Update contact properties if provided
if(property_exists($data, 'first_name')) {
    $contact->first_name = $data->first_name;
}
if(property_exists($data, 'last_name')) {
    $contact->last_name = $data->last_name;
}
if(property_exists($data, 'company')) {
    $contact->company = $data->company;
}
if(property_exists($data, 'job_title')) {
    $contact->job_title = $data->job_title;
}
if(property_exists($data, 'profile_picture')) {
    $contact->profile_picture = $data->profile_picture;
}
if(property_exists($data, 'notes')) {
    $contact->notes = $data->notes;
}
if(property_exists($data, 'favorite')) {
    $contact->favorite = $data->favorite;
}

// Update the contact
if($contact->update()) {
    // Handle contact information updates if provided
    if(property_exists($data, 'contact_info') && is_array($data->contact_info)) {
        foreach($data->contact_info as $info) {
            // Add new contact info
            if(!property_exists($info, 'info_id') && property_exists($info, 'info_type') && property_exists($info, 'info_value')) {
                $info_label = property_exists($info, 'info_label') ? $info->info_label : null;
                $is_primary = property_exists($info, 'is_primary') ? $info->is_primary : false;

                $contact->addContactInfo(
                    $info->info_type,
                    $info->info_value,
                    $info_label,
                    $is_primary
                );
            }
            // Update existing contact info
            else if(property_exists($info, 'info_id') && property_exists($info, 'info_value')) {
                $info_label = property_exists($info, 'info_label') ? $info->info_label : null;
                $is_primary = property_exists($info, 'is_primary') ? $info->is_primary : null;

                $contact->updateContactInfo(
                    $info->info_id,
                    $info->info_value,
                    $info_label,
                    $is_primary
                );
            }
        }
    }

    // Handle deleted contact info
    if(property_exists($data, 'delete_info') && is_array($data->delete_info)) {
        foreach($data->delete_info as $info_id) {
            $contact->deleteContactInfo($info_id);
        }
    }

    // Handle group updates if provided
    if(property_exists($data, 'add_groups') && is_array($data->add_groups)) {
        foreach($data->add_groups as $group_id) {
            $contact->addToGroup($group_id);
        }
    }

    if(property_exists($data, 'remove_groups') && is_array($data->remove_groups)) {
        foreach($data->remove_groups as $group_id) {
            $contact->removeFromGroup($group_id);
        }
    }

    // Handle tag updates if provided
    if(property_exists($data, 'add_tags') && is_array($data->add_tags)) {
        foreach($data->add_tags as $tag_id) {
            $contact->addTag($tag_id);
        }
    }

    if(property_exists($data, 'remove_tags') && is_array($data->remove_tags)) {
        foreach($data->remove_tags as $tag_id) {
            $contact->removeTag($tag_id);
        }
    }

    // Return success response
    Response::success("Contact updated successfully");
} else {
    // Failed to update contact
    Response::error("Failed to update contact");
}
?>