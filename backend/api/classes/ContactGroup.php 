<?php
// backend/api/classes/ContactGroup.php
class ContactGroup {
    // Database connection and table name
    private $conn;
    private $table_name = "ContactGroups";
    private $membership_table = "ContactGroupMembership";

    // Object properties
    public $group_id;
    public $user_id;
    public $group_name;
    public $description;
    public $color;
    public $created_at;
    public $updated_at;

    // Additional properties
    public $contact_count;

    // Constructor with DB connection
    public function __construct($db) {
        $this->conn = $db;
    }

    // Create new contact group
    public function create() {
        // Query to insert record
        $query = "INSERT INTO " . $this->table_name . "
                  SET user_id = :user_id,
                      group_name = :group_name,
                      description = :description,
                      color = :color";

        // Prepare query
        $stmt = $this->conn->prepare($query);

        // Sanitize input
        $this->user_id = htmlspecialchars(strip_tags($this->user_id));
        $this->group_name = htmlspecialchars(strip_tags($this->group_name));
        $this->description = htmlspecialchars(strip_tags($this->description));
        $this->color = htmlspecialchars(strip_tags($this->color));

        // Bind values
        $stmt->bindParam(":user_id", $this->user_id);
        $stmt->bindParam(":group_name", $this->group_name);
        $stmt->bindParam(":description", $this->description);
        $stmt->bindParam(":color", $this->color);

        // Execute query
        if($stmt->execute()) {
            $this->group_id = $this->conn->lastInsertId();
            return true;
        }

        return false;
    }

    // Check if group name already exists
    public function groupNameExists() {
        $query = "SELECT COUNT(*) FROM " . $this->table_name . "
                  WHERE user_id = :user_id AND group_name = :group_name";

        if($this->group_id) {
            $query .= " AND group_id != :group_id";
        }

        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":user_id", $this->user_id);
        $stmt->bindParam(":group_name", $this->group_name);

        if($this->group_id) {
            $stmt->bindParam(":group_id", $this->group_id);
        }

        $stmt->execute();

        return $stmt->fetchColumn() > 0;
    }

    // Read all groups for a user
    public function readAll($user_id) {
        $query = "SELECT g.*,
                 (SELECT COUNT(*) FROM " . $this->membership_table . " m WHERE m.group_id = g.group_id) as contact_count
                 FROM " . $this->table_name . " g
                 WHERE g.user_id = :user_id
                 ORDER BY g.group_name";

        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":user_id", $user_id);
        $stmt->execute();

        return $stmt;
    }

    // Read one group by ID
    public function readOne($group_id, $user_id) {
        $query = "SELECT g.*,
                 (SELECT COUNT(*) FROM " . $this->membership_table . " m WHERE m.group_id = g.group_id) as contact_count
                 FROM " . $this->table_name . " g
                 WHERE g.group_id = :group_id AND g.user_id = :user_id";

        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":group_id", $group_id);
        $stmt->bindParam(":user_id", $user_id);
        $stmt->execute();

        $row = $stmt->fetch(PDO::FETCH_ASSOC);

        if(!$row) {
            return false;
        }

        // Set properties
        $this->group_id = $row['group_id'];
        $this->user_id = $row['user_id'];
        $this->group_name = $row['group_name'];
        $this->description = $row['description'];
        $this->color = $row['color'];
        $this->created_at = $row['created_at'];
        $this->updated_at = $row['updated_at'];
        $this->contact_count = $row['contact_count'];

        return true;
    }

    // Update group
    public function update() {
        // Check if group name already exists
        if($this->groupNameExists()) {
            return false;
        }

        $query = "UPDATE " . $this->table_name . "
                  SET group_name = :group_name,
                      description = :description,
                      color = :color
                  WHERE group_id = :group_id AND user_id = :user_id";

        $stmt = $this->conn->prepare($query);

        // Sanitize input
        $this->group_name = htmlspecialchars(strip_tags($this->group_name));
        $this->description = htmlspecialchars(strip_tags($this->description));
        $this->color = htmlspecialchars(strip_tags($this->color));

        // Bind values
        $stmt->bindParam(":group_name", $this->group_name);
        $stmt->bindParam(":description", $this->description);
        $stmt->bindParam(":color", $this->color);
        $stmt->bindParam(":group_id", $this->group_id);
        $stmt->bindParam(":user_id", $this->user_id);

        if($stmt->execute()) {
            return true;
        }

        return false;
    }

    // Delete group
    public function delete() {
        $query = "DELETE FROM " . $this->table_name . "
                  WHERE group_id = :group_id AND user_id = :user_id";

        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":group_id", $this->group_id);
        $stmt->bindParam(":user_id", $this->user_id);

        if($stmt->execute()) {
            return true;
        }

        return false;
    }

    // Get contacts in group
    public function getContacts($page = 1, $limit = 10) {
        // Calculate offset for pagination
        $offset = ($page - 1) * $limit;

        $query = "SELECT c.*,
                 (SELECT GROUP_CONCAT(CONCAT(info_type, ':', info_value) SEPARATOR '|')
                  FROM ContactInformation
                  WHERE contact_id = c.contact_id AND is_primary = 1) as contact_info
                 FROM Contacts c
                 JOIN " . $this->membership_table . " m ON c.contact_id = m.contact_id
                 WHERE m.group_id = :group_id
                 ORDER BY c.first_name, c.last_name
                 LIMIT :limit OFFSET :offset";

        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":group_id", $this->group_id);
        $stmt->bindParam(":limit", $limit, PDO::PARAM_INT);
        $stmt->bindParam(":offset", $offset, PDO::PARAM_INT);
        $stmt->execute();

        return $stmt;
    }

    // Count contacts in group for pagination
    public function countContacts() {
        $query = "SELECT COUNT(*) as total
                 FROM " . $this->membership_table . "
                 WHERE group_id = :group_id";

        $stmt = $this->conn->prepare($query);
        $stmt->bindParam(":group_id", $this->group_id);
        $stmt->execute();

        $row = $stmt->fetch(PDO::FETCH_ASSOC);

        return $row['total'];
    }

    // Add contacts to group (bulk)
    public function addContacts($contact_ids) {
        // Begin transaction
        $this->conn->beginTransaction();

        try {
            foreach($contact_ids as $contact_id) {
                // Check if already in group
                $check_query = "SELECT COUNT(*) FROM " . $this->membership_table . "
                                WHERE contact_id = :contact_id AND group_id = :group_id";

                $check_stmt = $this->conn->prepare($check_query);
                $check_stmt->bindParam(":contact_id", $contact_id);
                $check_stmt->bindParam(":group_id", $this->group_id);
                $check_stmt->execute();

                if($check_stmt->fetchColumn() == 0) {
                    // Not in group, add it
                    $query = "INSERT INTO " . $this->membership_table . " (contact_id, group_id)
                              VALUES (:contact_id, :group_id)";

                    $stmt = $this->conn->prepare($query);
                    $stmt->bindParam(":contact_id", $contact_id);
                    $stmt->bindParam(":group_id", $this->group_id);
                    $stmt->execute();
                }
            }

            // Commit transaction
            $this->conn->commit();
            return true;
        } catch(Exception $e) {
            // Rollback in case of error
            $this->conn->rollBack();
            return false;
        }
    }

    // Remove contacts from group (bulk)
    public function removeContacts($contact_ids) {
        // Begin transaction
        $this->conn->beginTransaction();

        try {
            foreach($contact_ids as $contact_id) {
                $query = "DELETE FROM " . $this->membership_table . "
                          WHERE contact_id = :contact_id AND group_id = :group_id";

                $stmt = $this->conn->prepare($query);
                $stmt->bindParam(":contact_id", $contact_id);
                $stmt->bindParam(":group_id", $this->group_id);
                $stmt->execute();
            }

            // Commit transaction
            $this->conn->commit();
            return true;
        } catch(Exception $e) {
            // Rollback in case of error
            $this->conn->rollBack();
            return false;
        }
    }
}
?>